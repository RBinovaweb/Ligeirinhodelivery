{
  "rules": {
    "products": {
      ".read": true,
      ".write": "auth != null"
    },
    "settings": {
      ".read": true,
      ".write": "auth != null"
    },
    "orders": {
      ".read": "auth != null",
      ".write": true,
      "$orderId": {
        ".validate": "newData.hasChildren(['createdAt','customer','items','total','status'])"
      }
    }
  }
}